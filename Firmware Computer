#!/usr/bin/env python3
# Simple serial time responder for macOS / Linux
# Usage: python3 time_responder.py [serial_port]
# If no port given, attempts to auto-detect usbmodem/cu.usbmodem ports.

import sys
import time
from datetime import datetime
import serial
import serial.tools.list_ports

def find_port():
    ports = list(serial.tools.list_ports.comports())
    # look for likely USB serial device names
    for p in ports:
        if 'usbmodem' in p.device or 'USB' in p.description or 'CDC' in p.description:
            return p.device
    # fallback: return first port if any
    return ports[0].device if ports else None

def format_time_line():
    now = datetime.now()
    # weekday: Monday=0 .. Sunday=6 (aligns with your pad's day_names if you used Mon=0)
    wd = (now.weekday())  # 0..6
    return f"TIME:{now.year:04d}:{now.month:02d}:{now.day:02d}:{now.hour:02d}:{now.minute:02d}:{now.second:02d}:{wd}\n"

def main(portname=None, baud=115200, timeout=0.5):
    if portname is None:
        portname = find_port()
        if portname is None:
            print("No serial ports found. Plug in the device and retry, or supply a port name.")
            return
    print("Opening", portname)
    with serial.Serial(portname, baud, timeout=timeout) as ser:
        print("Listening for TIME_REQUEST...")
        buffer = ""
        try:
            while True:
                data = ser.read(ser.in_waiting or 1)
                if data:
                    try:
                        text = data.decode('utf-8', errors='ignore')
                    except Exception:
                        text = str(data)
                    buffer += text
                    # process full lines
                    while '\n' in buffer:
                        line, buffer = buffer.split('\n', 1)
                        line = line.strip()
                        if not line:
                            continue
                        print("Received:", line)
                        if line == "TIME_REQUEST":
                            resp = format_time_line()
                            ser.write(resp.encode('utf-8'))
                            print("Sent:", resp.strip())
                        # Optionally handle other commands
                else:
                    # no incoming data, sleep a bit
                    time.sleep(0.05)
        except KeyboardInterrupt:
            print("Exiting.")

if __name__ == "__main__":
    port = sys.argv[1] if len(sys.argv) > 1 else None
    main(port)
